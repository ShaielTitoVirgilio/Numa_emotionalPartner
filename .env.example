# ============================================================
# Variables de entorno de Numa
#
# Copiá este archivo a .env para desarrollo local:
#     cp .env.example .env
# y completá los valores. NUNCA subas el .env real al repo.
#
# En Railway estas mismas variables se cargan en Variables del servicio.
# Hay DOS servicios y cada uno tiene su propio juego:
#     numa          → rama main     → Supabase de PRODUCCIÓN
#     numa-dev      → rama staging  → Supabase de PRUEBAS
# ============================================================

# ── Entorno ─────────────────────────────────────────────────
# "production" o "staging".
# En staging, la PWA se instala como "Numa DEV" (ícono aparte en el celular)
# y muestra una franja naranja de aviso. Default: production.
APP_ENTORNO=staging

# ── Supabase ────────────────────────────────────────────────
# ⚠️ CRÍTICO: staging tiene que apuntar a un PROYECTO DISTINTO de Supabase.
# Si apunta al de producción, cada mensaje de prueba escribe memorias,
# conversaciones y crisis_logs reales sobre usuarios reales.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Modelos de lenguaje ─────────────────────────────────────
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Chat principal (la respuesta que ve el usuario)
CHAT_PROVIDER=openrouter
CHAT_MODEL=openai/gpt-5.6-luna
# Modelo del MODO LLAMADA (voz). Distinto del chat escrito a proposito: en voz
# pesa mas la latencia del PEOR turno que la mediana. Ver el comentario largo
# en app/core/config.py con las mediciones. Si se deja vacio, usa CHAT_MODEL.
CHAT_PROVIDER_LLAMADA=
CHAT_MODEL_LLAMADA=

CHAT_FALLBACK_PROVIDER=openrouter
CHAT_FALLBACK_MODEL=google/gemini-3-flash-preview

# Clasificador de contexto (corre en cada turno, antes del chat)
CONTEXT_ROUTER_PROVIDER=openrouter
CONTEXT_ROUTER_MODEL=qwen/qwen3-32b
CONTEXT_ROUTER_OPENROUTER_PROVIDERS=Nebius

# Verificador de crisis (confirma el riesgo antes de la respuesta de emergencia)
CRISIS_VERIFIER_PROVIDER=openrouter
CRISIS_VERIFIER_MODEL=google/gemini-3-flash-preview

# Modelo de Groq para el insight del dashboard
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_ROUTER=openai/gpt-oss-120b

# ── Observabilidad (Sentry) ─────────────────────────────────
# Sin DSN, Sentry no se inicializa y la app corre igual.
# El contenido de las conversaciones NUNCA se reporta: ver
# app/core/observability.py y scripts/verificar_sentry.py.
SENTRY_DSN=
# Separa los errores de cada entorno en el panel de Sentry.
SENTRY_ENVIRONMENT=staging
# 0 = sin datos de performance. 0.1 = trazas del 10% de los requests,
# útil para ver a qué se van los segundos con usuarios reales.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Otros ───────────────────────────────────────────────────
# Protege los endpoints de administración (/api/send-daily-push).
# La app NO ARRANCA si falta. Usá una distinta en cada entorno.
ADMIN_KEY=

# Notificaciones push (Web Push). Podés dejarla vacía en staging si no
# vas a probar push: solo falla ese endpoint, el resto anda igual.
VAPID_PRIVATE_KEY=
