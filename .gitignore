# Variables de entorno
# ".env" solo matchea ese nombre exacto: una copia como ".env.backup" o
# ".env.produccion" quedaba fuera del ignore y era commiteable CON las claves
# adentro. El patrón cubre cualquier variante; .env.example se exceptúa
# porque es la plantilla sin valores y sí tiene que estar en el repo.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / frontend
node_modules/

# OS
.DS_Store
CLAUDE.md

Chats/

# Claude Code internals
.claude/

# Scripts de prueba locales
test_proactiva.py
eval_70b_real.py
eval_router_real.py

# Notas internas de pendientes (doc local)
falta_implementar.md

# Registro de migración (ya aplicada en Supabase; se mantiene local como doc)
memories_event_migration.sql

reportar_bugs.txt
# Informe de auditoría interna
Analizis-Completo.txt

# Resultados de corridas de eval_multimodelo.py / eval_seguridad_router.py
eval_multimodelo_resultados.csv
eval_multimodelo_run*.log
eval_postrecorte.log

# Log de envíos del mail de descarga de la app (contiene emails de usuarios)
scripts/_enviados_descarga_app.log
